# --- Telegram ---
# BOT_TOKEN: токен бота от @BotFather (обязателен; без него поднимется только dev-сервер)
BOT_TOKEN=
# ADMIN_ID: ваш telegram user id (для /grant, /stats и уведомлений о новых пользователях)
ADMIN_ID=0
# SUPPORT: адрес поддержки, показывается в /pay
SUPPORT=@Leonidy

# --- Подписка ---
TEST_PERIOD_DAYS=7
SUBSCRIPTION_PRICE=250

# --- Парсинг ---
# интервал между циклами, сек
POLL_INTERVAL=60
HTTP_TIMEOUT=20
# токен API freelancehunt.com (без него источник freelancehunt вернёт 401)
FREELANCEHUNT_TOKEN=
# telegram-каналы для чтения через t.me/s/<имя>, через запятую
TELEGRAM_CHANNELS=freelancetaverna,flday,jobsfl

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
DB_PATH=/data/qviqa.sqlite3

# Переопределение URL источника (для dev/mock): SOURCE_URL_<ИМЯ>=<url>
# SOURCE_URL_FL_RU=http://127.0.0.1:9001/src/fl_ru
